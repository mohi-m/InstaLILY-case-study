# Copy to .env and fill in. Required for the agent and the scraper's embeddings.
OPENAI_API_KEY=sk-...

# Models (per spec)
LLM_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# Postgres (compose wires these; override for local runs)
POSTGRES_USER=partselect
POSTGRES_PASSWORD=partselect
POSTGRES_DB=partselect
# Used by backend & scraper containers (host = compose service name "db")
DATABASE_URL=postgresql://partselect:partselect@db:5432/partselect

# Frontend -> backend
NEXT_PUBLIC_API_BASE=http://localhost:8000
# CORS origin the backend allows
FRONTEND_ORIGIN=http://localhost:3000

# Scraper page caps (keep the demo crawl bounded)
SCRAPE_MAX_MODELS=40
SCRAPE_MAX_PARTS=200
SCRAPE_MIN_DELAY=3
SCRAPE_MAX_DELAY=7
