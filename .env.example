# Copy to .env and fill in. Required for the agent and the scraper's embeddings.
OPENAI_API_KEY=sk-...

# Models (per spec)
LLM_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# Used by backend & scraper.
# Local dev:
DATABASE_URL=postgresql://partselect:partselect@localhost:5432/partselect
# Production (Render Postgres): use the **Internal Database URL** when the
# backend lives on Render in the same region (private network, no TLS needed).
# For running the scraper locally against the Render DB, use the **External
# Database URL** instead — it includes `?sslmode=require`.

# Frontend -> backend
# Local dev:
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Production (Render): set to the deployed backend URL,
#   e.g. https://partselect-backend.onrender.com

# CORS origin the backend allows
# Local dev:
FRONTEND_ORIGIN=http://localhost:3000
# Production (Render): set to the deployed frontend URL,
#   e.g. https://partselect-frontend.onrender.com

# Scraper page caps (keep the demo crawl bounded)
SCRAPE_MIN_DELAY=2
SCRAPE_MAX_DELAY=4
SCRAPE_POOL_SIZE=1
SCRAPE_NAV_TIMEOUT_MS=4000
# Uncomment to scrape only a specific page (for testing/debugging)
# SCRAPE_ONLY = "ED5FVGXWS01"
